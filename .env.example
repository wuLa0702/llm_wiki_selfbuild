# LLM Wiki 环境变量配置

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 豆包 / 火山引擎 Ark API
ARK_API_KEY=your_ark_api_key_here
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_CHAT=your_ark_endpoint_id_here
ARK_MODEL_VISION=your_ark_endpoint_id_here

# LLM Provider 选择: deepseek / doubao
LLM_PROVIDER=deepseek

# SQLite 数据库路径（默认项目根目录）
WIKI_DB_PATH=wiki.db

# Wiki 根目录
WIKI_ROOT=.

# 日志配置（默认关闭）
LOG_ENABLED=false
LOG_LEVEL=INFO
LOG_FILE=logs/wiki.log
