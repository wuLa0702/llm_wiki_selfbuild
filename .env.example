# LLM Wiki 环境变量配置

# DeepSeek API（建议先配这个）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com

# 豆包 API（后续切换）
# DOUBAO_API_KEY=your_doubao_api_key_here
# DOUBAO_API_BASE=https://api.doubao.com

# LLM Provider 选择: deepseek / doubao / openai / claude
LLM_PROVIDER=deepseek

# SQLite 数据库路径（默认项目根目录）
WIKI_DB_PATH=wiki.db

# Wiki 根目录
WIKI_ROOT=.

# 日志配置（默认关闭）
LOG_ENABLED=false
LOG_LEVEL=INFO
LOG_FILE=logs/wiki.log
